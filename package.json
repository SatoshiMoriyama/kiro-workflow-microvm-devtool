{
  "name": "kiro-workflow-microvm-devtool",
  "version": "0.0.0",
  "private": true,
  "description": "Lambda MicroVMs 上で Kiro CLI を headless 実行し成果物を S3 に格納する開発ツール",
  "scripts": {
    "build": "pnpm -r build",
    "synth": "pnpm --filter infra synth",
    "deploy": "bash scripts/deploy.sh",
    "run-microvm": "bash scripts/run.sh",
    "package-image": "bash scripts/package-image.sh",
    "runs": "PYTHONPATH=packages/runs-cli python3 -m runs_cli",
    "runs:list": "PYTHONPATH=packages/runs-cli python3 -m runs_cli list",
    "runs:show": "PYTHONPATH=packages/runs-cli python3 -m runs_cli show",
    "runs:stats": "PYTHONPATH=packages/runs-cli python3 -m runs_cli stats",
    "runs:test": "cd packages/runs-cli && python3 -m unittest test_runs_cli"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  }
}
