{
  "name": "kiro-workflow-microvm-devtool",
  "version": "0.0.0",
  "private": true,
  "description": "Lambda MicroVMs 上で Kiro CLI を headless 実行し成果物を S3 に格納する開発ツール",
  "scripts": {
    "build": "pnpm -r build",
    "synth": "pnpm --filter infra synth",
    "deploy": "bash scripts/deploy.sh",
    "package-image": "bash scripts/package-image.sh",
    "runs:test": "cd packages/runs-cli && python3 -m unittest discover",
    "check:secrets": "python3 scripts/check_secrets.py",
    "scripts:test": "cd scripts && python3 -m unittest discover"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  }
}
